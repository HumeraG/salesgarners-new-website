# MySQL connection: mysql://USER:PASSWORD@HOST:PORT/DATABASE
DATABASE_URL="mysql://root:password@localhost:3306/salesgarners"

# Password for /admin
ADMIN_PASSWORD="change-me"

# Random long string used to sign the admin session cookie
SESSION_SECRET="replace-with-a-long-random-string"

# Optional: Google Analytics 4 measurement ID. Leave empty to disable analytics and the cookie banner.
NEXT_PUBLIC_GA_ID=
